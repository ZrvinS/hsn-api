# hsn-api environment. Copy to .env, then load it into your shell before any npm script:
#   cp .env.example .env
#   set -a; . ./.env; set +a
# The server and the scripts read process.env only (there is no dotenv loader). Every variable is
# validated at start-up by src/config.ts (EnvSchema); a bad value stops the process with a message.
# Lines that are commented out use the default shown.
#
# Generating secrets (each one different, >= 32 characters):
#   openssl rand -hex 32
#   node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Never commit .env (it is in .gitignore). Keep HSN_AUDIT_KEY off the database host's backups.

# ---------------------------------------------------------------- required
# development | test | production. No default: it must be set explicitly.
NODE_ENV=development
# SQLite file. Created and migrated on first use.
HSN_DB_PATH=./hsn.db
# In production also set HSN_STATE_HWM_FILE (see "admin and data integrity" below) and HSN_TRUST_PROXY or
# HSN_DIRECT_EXPOSURE=true.

# Secrets. REQUIRED unless NODE_ENV=test. The quick start in README.md appends generated values for
# these three to .env; for production, generate them once and keep them in your secret store.
# HMAC pepper for API-key hashes (>= 32 chars). Use either HSN_KEY_PEPPER or HSN_KEY_PEPPERS, not both.
# HSN_KEY_PEPPER=<openssl rand -hex 32>
# Pepper rotation instead of HSN_KEY_PEPPER: "id:secret,id:secret", NEWEST FIRST. A key issued under
# HSN_KEY_PEPPER has pepper_id "default", so list the old pepper as "default:<secret>".
# HSN_KEY_PEPPERS=p2:<new secret>,default:<old secret>
# HMAC key for the audit chain (>= 32 chars, must differ from every pepper). Losing it makes the audit
# chain unverifiable; changing it breaks verification of existing entries.
# HSN_AUDIT_KEY=<openssl rand -hex 32>
# HMAC key for product-name fingerprints in logs (>= 32 chars). Required in production; a random
# per-process key is used otherwise.
# HSN_LOG_KEY=<openssl rand -hex 32>

# ---------------------------------------------------------------- listeners
# Public API listener.
# HSN_HOST=0.0.0.0
# HSN_PORT=3000
# Admin API and /metrics listener (separate, ruling 25). Keep it on loopback and reach it over SSH/VPN.
# In production a non-loopback HSN_ADMIN_HOST requires HSN_ADMIN_IP_ALLOWLIST.
# HSN_ADMIN_HOST=127.0.0.1
# HSN_ADMIN_PORT=3001
# Comma-separated IPs/CIDRs allowed to use admin keys and scrape /metrics (empty = no IP restriction).
# HSN_ADMIN_IP_ALLOWLIST=10.0.0.0/8
# Reverse proxy addresses/CIDRs whose X-Forwarded-For is trusted. Never "true". In production, leave it
# empty only together with HSN_DIRECT_EXPOSURE=true (clients connect directly).
# HSN_TRUST_PROXY=
# HSN_DIRECT_EXPOSURE=false
# Exact browser origins allowed by CORS (comma-separated, e.g. https://app.example.com). Empty = none.
# HSN_CORS_ORIGINS=
# fatal | error | warn | info | debug | trace | silent
# HSN_LOG_LEVEL=info

# ---------------------------------------------------------------- limits
# Default per-key token bucket per minute (classify costs 5 tokens, tax 1 + floor(lines/50)).
# HSN_RATE_LIMIT_PER_MIN=600
# Per-IP bucket for unauthenticated requests.
# HSN_RATE_LIMIT_UNAUTH_PER_MIN=60
# Default daily quota per key (tokens per IST day).
# HSN_DAILY_QUOTA_DEFAULT=50000
# Failed authentications from one address before it is blocked for a while.
# HSN_AUTH_FAIL_BLOCK_THRESHOLD=20
# Product cache bound (rows); the oldest fetched rows are evicted first.
# HSN_PRODUCT_CACHE_MAX_ROWS=50000

# ---------------------------------------------------------------- admin and data integrity
# false makes every admin write return 503 admin-writes-disabled (incident switch).
# HSN_ADMIN_WRITES_ENABLED=true
# Hours within which an approved admin_grant must be redeemed with create-key --grant (1-72; the DB caps it at 72).
# HSN_ADMIN_GRANT_TTL_HOURS=72
# Restore-detection high-water mark (sidecar file MAC'd with HSN_AUDIT_KEY). Development default:
# "<HSN_DB_PATH>.hwm.json". REQUIRED in production, and its directory must NOT be the database's directory:
# put it on a different volume and backup set (a backup that restores both together defeats detection).
# A missing sidecar for a database that had one is treated as a restore (alert dataset.hwm_missing,
# /readyz 503 until `npm run ack-restore`). "off" disables detection (refused in production).
# Production example, next to HSN_DB_PATH=/var/lib/hsn/hsn.db:
# HSN_STATE_HWM_FILE=/var/lib/hsn-state/hwm.json
# Optional Ed25519 private key (base64 PKCS#8 DER) that signs each dataset content hash. Generate with:
#   openssl genpkey -algorithm ed25519 -outform DER | base64 -w0
# HSN_DATASET_SIGNING_KEY=
# Change-feed retention in days (unset = keep everything).
# HSN_FEED_RETENTION_DAYS=
# Allowed IGST slabs in basis points for proposals and the seed.
# HSN_ALLOWED_RATES_BP=0,10,25,100,150,300,500,600,1200,1800,2800,4000
# Hosts allowed in a rule's source URL (exact names).
# HSN_SOURCE_HOSTS=cbic-gst.gov.in,www.cbic-gst.gov.in,taxinformation.cbic.gov.in,cbic.gov.in,www.cbic.gov.in,egazette.gov.in,www.egazette.gov.in,gstcouncil.gov.in,www.gstcouncil.gov.in
# Listing/index pages that are never a notification document (ruling 36), CSV of absolute URLs. These are added to
# the built-in set (central-tax-rate.html, integrated-tax-rate.html, gst-goods-services-rates.html and the watcher
# pages). A rule citing one of them, or any URL that is not a plain document path, can be verified only with a
# document source.url; create/supersede/correct must cite a document. A document URL has no query or fragment, no
# ;, .., //, %2e, %2f or %5c in its path, and a path of /view-pdf/<id>[/...] or a *.pdf file. Index pages are
# compared on origin plus lower-cased path (repeated slashes collapsed, query and fragment ignored).
# HSN_SOURCE_INDEX_PAGES=
# Curated known data gaps served as known_data_gaps[] by GET /v1/meta/dataset. Read once at boot; not part of the
# dataset hash. Default: data/seed/known_gaps.json (may be absent: then []). When set explicitly the file must exist,
# be a regular file of at most 256 KiB and parse, or the boot is refused; in production the path must be absolute.
# HSN_KNOWN_GAPS_FILE=

# ---------------------------------------------------------------- tests only
# TRD read by test/docs/traceability.test.ts. A missing file FAILS the suite; set it to skip to skip the check
# (e.g. in a checkout without the docs).
# HSN_TRD_PATH=../docs/02-TRD.md

# ---------------------------------------------------------------- barcode adapters (off by default)
# Master kill switch for all outbound product lookups.
# HSN_ADAPTERS_ENABLED=false
# Open Food Facts / Open Beauty Facts. Each needs HSN_ADAPTERS_ENABLED=true, a contact User-Agent and
# its host in HSN_OUTBOUND_ALLOWLIST.
# HSN_OFF_ENABLED=false
# HSN_OBF_ENABLED=false
# HSN_OFF_USER_AGENT=hsn-api/0.1 (ops@example.com)
# HSN_OUTBOUND_ALLOWLIST=world.openfoodfacts.org,world.openbeautyfacts.org
# Outbound lookups (cache misses) per key per IST day, per-host minute budgets and the global queue.
# HSN_OUTBOUND_PER_KEY_DAILY=500
# HSN_OFF_RATE_PER_MIN=15
# HSN_OBF_RATE_PER_MIN=10
# HSN_OUTBOUND_QUEUE_MAX=4

# ---------------------------------------------------------------- LLM re-rank (off by default)
# Enabling sends product names to the provider: HSN_LLM_DATA_DISCLOSURE_ACK=true is required.
# HSN_LLM_ENABLED=false
# HSN_LLM_PROVIDER=
# HSN_LLM_MODEL=
# HSN_LLM_API_KEY=
# HSN_LLM_DATA_DISCLOSURE_ACK=false
# HSN_LLM_CALLS_PER_MIN=30
# HSN_LLM_CALLS_PER_DAY=5000

# ---------------------------------------------------------------- CBIC notification watcher
# In-process interval (off by default; production normally runs `npm run watch-cbic` from cron).
# HSN_WATCHER_ENABLED=false
# HSN_WATCHER_INTERVAL_MIN=360
# HSN_WATCHER_HOSTS=cbic-gst.gov.in,www.cbic-gst.gov.in,taxinformation.cbic.gov.in,www.cbic.gov.in
# Listing pages (empty string disables a page); hosts must be in both HSN_WATCHER_HOSTS and HSN_SOURCE_HOSTS.
# HSN_WATCHER_CT_RATE_URL=https://cbic-gst.gov.in/central-tax-rate.html
# HSN_WATCHER_IT_RATE_URL=https://cbic-gst.gov.in/integrated-tax-rate.html
# HSN_WATCHER_USER_AGENT=hsn-api-watcher/0.1 (rate notification watcher)
# Notifications dated before this are not queued.
# HSN_WATCHER_NOT_BEFORE=2025-09-17

# ---------------------------------------------------------------- operator scripts only
# Your own admin API key, read by `npm run import-dataset` (never pass it on the command line).
# HSN_ADMIN_KEY=
