{
  "name": "hsn-api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "tsx watch src/main.ts",
    "build": "tsc -p tsconfig.build.json && node -e \"require('node:fs').cpSync('src/db/schema.sql','dist/db/schema.sql')\"",
    "start": "node dist/main.js",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "seed": "tsx scripts/seed.ts",
    "create-key": "tsx scripts/create-key.ts",
    "bootstrap-admins": "tsx scripts/bootstrap-admins.ts",
    "export-audit-head": "tsx scripts/export-audit-head.ts",
    "verify-audit": "tsx scripts/verify-audit.ts",
    "rotate-feed-epoch": "tsx scripts/rotate-feed-epoch.ts",
    "disable-actor": "tsx scripts/disable-actor.ts",
    "ack-restore": "tsx scripts/ack-restore.ts",
    "watch-cbic": "tsx scripts/watch-cbic.ts",
    "eval": "tsx scripts/eval-classifier.ts",
    "import-dataset": "tsx scripts/import-dataset.ts"
  },
  "dependencies": {
    "fastify": "5.12.5",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/node": "22.20.5",
    "tsx": "4.23.15",
    "typescript": "5.9.3",
    "vitest": "5.0.3"
  }
}
